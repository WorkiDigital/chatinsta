# Required for the EasyPanel/VPS Docker Compose deployment.
# Replace every placeholder before deploying. Do not commit real secrets.
NEXTAUTH_URL=https://app.example.com
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-different-strong-random-secret
ENCRYPTION_KEY=replace-with-exactly-64-hex-characters
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# DATABASE_URL and REDIS_URL are injected by docker-compose.vps.yml and must
# not be set in the EasyPanel environment.

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can create an account and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Meta / Instagram (optional; leave unset when using Zernio)
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
